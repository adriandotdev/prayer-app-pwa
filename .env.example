# Supabase: Connect dialog in the dashboard, or Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used to delete accounts. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Supabase dashboard -> Settings -> API Keys (secret key). In Vercel, add it as a non-public variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public origin used for the Google sign-in redirect (e.g. https://ora.example.com).
# Leave empty in dev; the request host is used.
NEXT_PUBLIC_SITE_URL=

# Public support address shown on the privacy policy, terms and profile. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to "true" on the production project only. Anything else serves robots.txt "Disallow: /" and a noindex tag,
# which keeps staging and previews out of search results.
ALLOW_INDEXING=
